# ====================================
# MoodCopilot 环境变量配置
# 复制此文件为 .env 并填入真实值
# cp .env.example .env
# ====================================

# ====================================
# 数据库配置
# ====================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mood_copilot_db
DB_USERNAME=root
DB_PASSWORD=your_db_password

# ====================================
# Redis 配置（需 redis-stack-server，含 RediSearch 向量引擎）
# ====================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ====================================
# 邮箱配置（验证码发送）
# ====================================
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your_email@qq.com
MAIL_PASSWORD=your_smtp_auth_code

# ====================================
# DeepSeek AI 配置
# ====================================
DEEPSEEK_API_KEY=sk-your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro

# ====================================
# 向量模型配置（SiliconFlow BAAI/bge-m3）
# ====================================
SILICONFLOW_API_KEY=sk-your_siliconflow_api_key

# ====================================
# JWT 签名密钥（生产环境请更换为随机字符串）
# ====================================
JWT_SECRET=change_me_to_a_random_secret

# ====================================
# 阿里云 OSS 对象存储配置
# ====================================
OSS_ENDPOINT=oss-cn-guangzhou.aliyuncs.com
OSS_BUCKET=your_bucket_name
OSS_ACCESS_KEY=your_oss_access_key
OSS_SECRET_KEY=your_oss_secret_key

# ====================================
# 视觉模型配置（阿里云百炼 DashScope qwen3-vl-flash）
# ====================================
VISION_API_KEY=sk-your_dashscope_api_key
VISION_MODEL=qwen3-vl-flash

# ====================================
# CORS 允许的来源（逗号分隔）
# ====================================
CORS_ALLOWED_ORIGINS=http://localhost:5173

